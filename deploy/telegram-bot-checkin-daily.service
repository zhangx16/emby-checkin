[Unit]
Description=Run custom Telegram bot daily check-in
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/glados-checkin-web
EnvironmentFile=-/opt/glados-checkin-web/.env
Environment=CHECKIN_PROJECT_ROOT=/opt/glados-checkin-web
ExecStart=/opt/glados-checkin-web/scripts/telegram_bot_checkin_once.sh
