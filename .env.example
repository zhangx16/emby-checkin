# Web server
HOST=127.0.0.1
PORT=22821
REQUEST_TIMEOUT_MS=20000

# Dashboard login
ADMIN_USER=admin
ADMIN_PASS=change-this-password
SESSION_SECRET=replace-with-a-long-random-string

# Provider defaults
DEFAULT_EMBYPULSE_BASE_URL=https://embypulse.example.com

# Optional Telegram report bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=false

# Daily check-in retry behavior
CHECKIN_MAX_ATTEMPTS=3
CHECKIN_RETRY_DELAY_MS=5000
TELEGRAM_ALERT_ON_FAILURE=true

# Optional custom data file paths
GLADOS_ACCOUNTS_FILE=
EMBYPULSE_ACCOUNTS_FILE=
INCUDAL_ACCOUNTS_FILE=

# Optional override used by shell/python helper scripts
CHECKIN_PROJECT_ROOT=
