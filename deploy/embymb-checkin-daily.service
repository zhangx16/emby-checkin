[Unit]
Description=Run EmbyMB daily check-in and Telegram report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/glados-checkin-web
EnvironmentFile=-/root/glados-checkin-web/.env
Environment=CHECKIN_PROJECT_ROOT=/root/glados-checkin-web
ExecStart=/usr/bin/node /root/glados-checkin-web/scripts/embymb_daily_checkin.js
