# Web server
HOST=127.0.0.1
PORT=22821
REQUEST_TIMEOUT_MS=20000
DEFAULT_DIAN115_BASE_URL=https://m.dian115.com

# Dashboard login
ADMIN_USER=admin
ADMIN_PASS=change-this-password
SESSION_SECRET=replace-with-a-long-random-string

# Mobile / PersonalToolbox API (Bearer or X-API-Key)
# curl -H "Authorization: Bearer $APP_API_TOKEN" https://checkin.example.com/api/v1/summary
APP_API_TOKEN=replace-with-a-long-random-token
# CHECKIN_API_TOKEN is accepted as an alias of APP_API_TOKEN

# Provider defaults
DEFAULT_EMBYPULSE_BASE_URL=https://embypulse.example.com
DEFAULT_EMBYMB_BASE_URL=https://embymb.ichinosekotomi.com
DEFAULT_ZHOUSANWAN_BASE_URL=https://zhousanwan.xyz

# Optional Telegram report bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=false

# Daily check-in retry behavior
CHECKIN_MAX_ATTEMPTS=3
CHECKIN_RETRY_DELAY_MS=5000
TELEGRAM_ALERT_ON_FAILURE=true

# Optional custom data file paths
GLADOS_ACCOUNTS_FILE=
EMBYPULSE_ACCOUNTS_FILE=
EMBYMB_ACCOUNTS_FILE=
ZHOUSANWAN_ACCOUNTS_FILE=

# Optional override used by shell/python helper scripts
CHECKIN_PROJECT_ROOT=
